# Workspace .env (~/conductorscore/.env) provides these; .env.example documents the contract.
#
# Environment switch (server-side only; affects which Supabase the Next.js app talks to):
APP_ENV=local                                   # local | prod

# Local Supabase CLI defaults (used when APP_ENV=local).
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_NEXT_PUBLIC_SUPABASE_ANON_KEY=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=

# Prod Supabase.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub OAuth — dev app (used when APP_ENV=local; enables real OAuth flow against local Supabase).
GITHUB_DEV_OAUTH_CLIENT_ID=
GITHUB_DEV_OAUTH_CLIENT_SECRET=

# Python client: where to upload to. Override for local-server development:
#   CONDUCTORSCORE_BASE_URL=http://localhost:3000 python -m conductorscore.run
CONDUCTORSCORE_BASE_URL=https://conductorscore.com

# GitHub Device Flow client_id (public — no secret required).
# Copy to .env.local with the real value:
CONDUCTORSCORE_GITHUB_CLIENT_ID=Ov23litmD8cHtbJmD12h
